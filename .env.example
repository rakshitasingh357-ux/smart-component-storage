# ---- Database ----
DATABASE_URL=sqlite:///./smart_storage.db

# ---- JWT Auth ----
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- SMTP (for shelf-life email alerts) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Smart Component Storage

# ---- Alert scheduling ----
# How close (in days) to shelf-life expiry before an email alert fires
SHELF_LIFE_ALERT_THRESHOLD_DAYS=7
# How often (in hours) the background job checks inventory
ALERT_CHECK_INTERVAL_HOURS=12
